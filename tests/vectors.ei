//! Test vectors made by the reference implementations (scripts/gen-vectors.py): zlib's deflate,
//! zlib and gzip framing, and libzstd. Each is a hex string; `v(name)` decodes it.

import core.sys
import std.encoding

pub fn v(name: str) -> List[u8] { vs(String.from(name)) }

pub fn vs(name: String) -> List[u8] {
    if name == String.from("raw0_empty") { return unhex("010000ffff") }
    if name == String.from("raw1_empty") { return unhex("0300") }
    if name == String.from("raw6_empty") { return unhex("0300") }
    if name == String.from("raw9_empty") { return unhex("0300") }
    if name == String.from("fixed_empty") { return unhex("0300") }
    if name == String.from("huff_empty") { return unhex("0300") }
    if name == String.from("rle_empty") { return unhex("0300") }
    if name == String.from("zlib6_empty") { return unhex("789c030000000001") }
    if name == String.from("gz6_empty") { return unhex("1f8b080000000000000303000000000000000000") }
    if name == String.from("zst1_empty") { return unhex("28b52ffd240001000099e9d851") }
    if name == String.from("zst3_empty") { return unhex("28b52ffd2000010000") }
    if name == String.from("zst19_empty") { return unhex("28b52ffd240001000099e9d851") }
    if name == String.from("raw0_one") { return unhex("010100feff61") }
    if name == String.from("raw1_one") { return unhex("4b0400") }
    if name == String.from("raw6_one") { return unhex("4b0400") }
    if name == String.from("raw9_one") { return unhex("4b0400") }
    if name == String.from("fixed_one") { return unhex("4b0400") }
    if name == String.from("huff_one") { return unhex("4b0400") }
    if name == String.from("rle_one") { return unhex("4b0400") }
    if name == String.from("zlib6_one") { return unhex("789c4b040000620062") }
    if name == String.from("gz6_one") { return unhex("1f8b08000000000000034b040043beb7e801000000") }
    if name == String.from("zst1_one") { return unhex("28b52ffd2401090000615b6e8ca9") }
    if name == String.from("zst3_one") { return unhex("28b52ffd200109000061") }
    if name == String.from("zst19_one") { return unhex("28b52ffd2401090000615b6e8ca9") }
    if name == String.from("raw0_hello") { return unhex("") }
    if name == String.from("raw1_hello") { return unhex("f348cdc9c9d751c840a1caf38b725214153c5004a14a46881c00") }
    if name == String.from("raw6_hello") { return unhex("f348cdc9c9d751c840a1caf38b725214153c46b01c00") }
    if name == String.from("raw9_hello") { return unhex("f348cdc9c9d751c840a1caf38b725214153c46b01c00") }
    if name == String.from("fixed_hello") { return unhex("f348cdc9c9d751c840a1caf38b725214153c46b01c00") }
    if name == String.from("huff_hello") { return unhex("05c1b10900201443c155629f411cc4c02f1e046c5cdfbb1da835815a13a8f57a394b3b506b02b52650ebf5729676a0d6046a4da0d6ebe52ced40ad09d49a40add7cb59da815a13a835815aaf97b3b403b526506b02b55e2f6769076a4da0d6046abd5eced20ed49a40ad09d47abd9ca51da835815a13a8f57a394b3b506b02b52650ebf572963e") }
    if name == String.from("rle_hello") { return unhex("05c1b10900201443c155629f411cc4c02f1e046c5cdfbb1da835815a13a8f57a394b3b506b02b52650ebf5729676a0d6046a4da0d6ebe52ced40ad09d49a40add7cb59da815a13a835815aaf97b3b403b526506b02b55e2f6769076a4da0d6046abd5eced20ed49a40ad09d47abd9ca51da835815a13a8f57a394b3b506b02b52650ebf572963e") }
    if name == String.from("zlib6_hello") { return unhex("789cf348cdc9c9d751c840a1caf38b725214153c46b01c00cbf15e1b") }
    if name == String.from("gz6_hello") { return unhex("1f8b0800000000000003f348cdc9c9d751c840a1caf38b725214153c46b01c007298419818010000") }
    if name == String.from("zst1_hello") { return unhex("28b52ffd641800f500008048656c6c6f2c2068776f726c642120480400e49f144006701e5c47e1028de4c194") }
    if name == String.from("zst3_hello") { return unhex("28b52ffd601800f500008048656c6c6f2c2068776f726c642120480400e49f144006701e5c47e102") }
    if name == String.from("zst19_hello") { return unhex("28b52ffd641800cd00008048656c6c6f2c2068776f726c642120480200f89f14d751b88de4c194") }
    if name == String.from("raw0_text") { return unhex("") }
    if name == String.from("raw1_text") { return unhex("") }
    if name == String.from("raw6_text") { return unhex("") }
    if name == String.from("raw9_text") { return unhex("") }
    if name == String.from("fixed_text") { return unhex("") }
    if name == String.from("huff_text") { return unhex("") }
    if name == String.from("rle_text") { return unhex("") }
    if name == String.from("zlib6_text") { return unhex("") }
    if name == String.from("gz6_text") { return unhex("") }
    if name == String.from("zst1_text") { return unhex("") }
    if name == String.from("zst3_text") { return unhex("") }
    if name == String.from("zst19_text") { return unhex("") }
    if name == String.from("raw0_zeros") { return unhex("") }
    if name == String.from("raw1_zeros") { return unhex("edd03101000000c2a0f54f6d0a3f884061c0800103060c183060c0800103060c183060c0c07b60") }
    if name == String.from("raw6_zeros") { return unhex("edc13101000000c2a0f54f6d0a3fa00000000080b701") }
    if name == String.from("raw9_zeros") { return unhex("edc13101000000c2a0f54f6d0a3fa00000000080b701") }
    if name == String.from("fixed_zeros") { return unhex("63601805a360148c8251300a46c1281805a360148c8251300a46c1281805a36014d01a0000") }
    if name == String.from("huff_zeros") { return unhex("") }
    if name == String.from("rle_zeros") { return unhex("edc13101000000c220fba75e0a3f6000000000c05d") }
    if name == String.from("zlib6_zeros") { return unhex("789cedc13101000000c2a0f54f6d0a3fa00000000080b70113880001") }
    if name == String.from("gz6_zeros") { return unhex("1f8b0800000000000003edc13101000000c2a0f54f6d0a3fa00000000080b701a80ee5d888130000") }
    if name == String.from("zst1_zeros") { return unhex("28b52ffd6488124d0000100000010083d3032c25b73230") }
    if name == String.from("zst3_zeros") { return unhex("28b52ffd6088124d0000100000010083d3032c") }
    if name == String.from("zst19_zeros") { return unhex("28b52ffd6488124500000800010084d3032125b73230") }
    if name == String.from("raw0_bytes") { return unhex("") }
    if name == String.from("raw1_bytes") { return unhex("") }
    if name == String.from("raw6_bytes") { return unhex("") }
    if name == String.from("raw9_bytes") { return unhex("") }
    if name == String.from("fixed_bytes") { return unhex("") }
    if name == String.from("huff_bytes") { return unhex("") }
    if name == String.from("rle_bytes") { return unhex("") }
    if name == String.from("zlib6_bytes") { return unhex("") }
    if name == String.from("gz6_bytes") { return unhex("") }
    if name == String.from("zst1_bytes") { return unhex("") }
    if name == String.from("zst3_bytes") { return unhex("") }
    if name == String.from("zst19_bytes") { return unhex("") }
    if name == String.from("gz_name") { return unhex("1f8b080800000000000368656c6c6f2e74787400f348cdc9c9d751c840a1caf38b725214153c46b01c007298419818010000") }
    if name == String.from("gz_all") { return unhex("1f8b081e00f1536500030800585904006162636468656c6c6f2e747874006120636f6d6d656e74007bbff348cdc9c9d751c840a1caf38b725214153c46b01c007298419818010000") }
    if name == String.from("gz_hcrc") { return unhex("1f8b0802000000000003a777f348cdc9c9d751c840a1caf38b725214153c46b01c007298419818010000") }
    if name == String.from("gz_two") { return unhex("") }
    if name == String.from("gz_pad") { return unhex("1f8b0800000000000003f348cdc9c9d751c840a1caf38b725214153c46b01c0072984198180100000000000000000000") }
    if name == String.from("zlib_dict_input") { return unhex("48656c6c6f2c2068656c6c6f2c2068656c6c6f2c20776f726c642120") }
    if name == String.from("zlib_dict") { return unhex("78bb8c04096af31895c32a0700cbf15e1b") }
    if name == String.from("zlib_level1") { return unhex("7801f348cdc9c9d751c840a1caf38b725214153c5004a14a46881c00cbf15e1b") }
    if name == String.from("zlib_level9") { return unhex("78daf348cdc9c9d751c840a1caf38b725214153c46b01c00cbf15e1b") }
    if name == String.from("zst_two_frames") { return unhex("") }
    if name == String.from("zst_skippable") { return unhex("502a4d1805000000736b69702128b52ffd601800f500008048656c6c6f2c2068776f726c642120480400e49f144006701e5c47e102") }
    if name == String.from("zst3_big") { return unhex("") }
    if name == String.from("zst19_big") { return unhex("") }
    if name == String.from("raw6_big") { return unhex("") }
    List.new()
}

fn unhex(s: str) -> List[u8] {
    match encoding.unhex(sys.lit(s)) {
        Ok(b) => b
        Err(_) => List.new()
    }
}

/// The names of every vector.
pub fn names() -> List[str] {
    List["raw0_empty", "raw1_empty", "raw6_empty", "raw9_empty", "fixed_empty", "huff_empty", "rle_empty", "zlib6_empty", "gz6_empty", "zst1_empty", "zst3_empty", "zst19_empty", "raw0_one", "raw1_one", "raw6_one", "raw9_one", "fixed_one", "huff_one", "rle_one", "zlib6_one", "gz6_one", "zst1_one", "zst3_one", "zst19_one", "raw0_hello", "raw1_hello", "raw6_hello", "raw9_hello", "fixed_hello", "huff_hello", "rle_hello", "zlib6_hello", "gz6_hello", "zst1_hello", "zst3_hello", "zst19_hello", "raw0_text", "raw1_text", "raw6_text", "raw9_text", "fixed_text", "huff_text", "rle_text", "zlib6_text", "gz6_text", "zst1_text", "zst3_text", "zst19_text", "raw0_zeros", "raw1_zeros", "raw6_zeros", "raw9_zeros", "fixed_zeros", "huff_zeros", "rle_zeros", "zlib6_zeros", "gz6_zeros", "zst1_zeros", "zst3_zeros", "zst19_zeros", "raw0_bytes", "raw1_bytes", "raw6_bytes", "raw9_bytes", "fixed_bytes", "huff_bytes", "rle_bytes", "zlib6_bytes", "gz6_bytes", "zst1_bytes", "zst3_bytes", "zst19_bytes", "gz_name", "gz_all", "gz_hcrc", "gz_two", "gz_pad", "zlib_dict_input", "zlib_dict", "zlib_level1", "zlib_level9", "zst_two_frames", "zst_skippable", "zst3_big", "zst19_big", "raw6_big"]
}
