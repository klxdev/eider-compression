//! compression.codec: one interface over gzip, zlib, raw deflate and zstd, chosen at run time,
//! for what HTTP calls a content coding (RFC 9110 "Content-Encoding"), a file's extension, or
//! the first bytes of a stream.
//!
//! `format_of(name)` maps a coding name (`gzip`, `x-gzip`, `deflate`, `zstd`, `identity`) to a
//! `Format`; `Decoder` and `Encoder` run any format in chunks; `decode` and `encode` do a whole
//! buffer; `detect(head)` guesses the format of a stream from its first bytes.
//!
//! `Deflate` is what the `deflate` coding really is in the wild: zlib framing (what RFC 9110
//! says) or, from some servers, a raw deflate stream; a Decoder tells them apart by the header.

import compression
import compression.deflate as deflate
import compression.gzip as gzip
import compression.zlib as zlib
import compression.zstd as zstd

/// The formats. `Deflate` decodes zlib or raw deflate (by the header) and encodes zlib. `Auto`
/// decodes any of them by the first bytes. `Identity` copies.
pub type Format =
    | Gzip
    | Zlib
    | Raw
    | Deflate
    | Zstd
    | Identity
    | Auto

/// The format a Content-Encoding (or Accept-Encoding) token names, ignoring case; None for
/// others (`br`, `compress`, ...).
pub fn format_of(name: List[u8]) -> Option[Format] {
    let mut low: List[u8] = List.new()
    for c in name {
        low.push(if c >= 65 && c <= 90 { c + 32 } else { c })
    }
    if eq(low, "gzip") || eq(low, "x-gzip") { return Some(Gzip) }
    if eq(low, "deflate") { return Some(Deflate) }
    if eq(low, "zstd") { return Some(Zstd) }
    if eq(low, "identity") { return Some(Identity) }
    None
}

fn eq(b: List[u8], s: str) -> bool {
    let t = s.bytes()
    if b.len() != t.len() { return false }
    for i in 0..b.len() {
        if b[i] != t[i] { return false }
    }
    true
}

/// The token to send in Content-Encoding for `f` (`Raw` and `Auto` have none: `deflate` and
/// `identity`).
pub fn name(f: Format) -> str {
    match f {
        Gzip => "gzip"
        Zlib => "deflate"
        Raw => "deflate"
        Deflate => "deflate"
        Zstd => "zstd"
        Identity => "identity"
        Auto => "identity"
    }
}

/// The format of a stream from its first bytes (at least 4 help): gzip and zstd by their magic
/// numbers, zlib by a valid header, else raw deflate. None if `head` is empty.
pub fn detect(head: List[u8]) -> Option[Format] {
    if head.len() == 0 { return None }
    if head.len() >= 2 && head[0] == 31 && head[1] == 139 { return Some(Gzip) }
    if head.len() >= 4 && head[0] == 40 && head[1] == 181 && head[2] == 47 && head[3] == 253 { return Some(Zstd) }
    if head.len() >= 2 && (head[0] & 15) == 8 && (head[0] >> 4) <= 7 && (((head[0] as u32) << 8) | (head[1] as u32)) % 31 == 0 {
        return Some(Zlib)
    }
    Some(Raw)
}

type Dec =
    | None_
    | G(gzip.Decoder)
    | Z(zlib.Decoder)
    | R(deflate.Inflater)
    | S(zstd.Decoder)
    | Copy

/// A decoder for any format. Make one with `decoder(format, limits)`.
pub type Decoder = { fmt: Format, lim: compression.Limits, d: Dec, head: List[u8], fed: u64 }

pub fn decoder(fmt: Format, lim: compression.Limits) -> Decoder {
    let mut x = Decoder(fmt, lim, None_, List.new(), 0)
    match fmt {
        Gzip => { x.d = G(gzip.decoder(lim)) }
        Zlib => { x.d = Z(zlib.decoder(lim)) }
        Raw => { x.d = R(deflate.inflater(lim)) }
        Zstd => { x.d = S(zstd.decoder(lim)) }
        Identity => { x.d = Copy }
        Deflate => {}
        Auto => {}
    }
    x
}

fn started(d: Dec) -> bool {
    match d {
        None_ => false
        _ => true
    }
}

impl Decoder {
    /// Adds a chunk of input and appends what it decodes to `out`.
    fn feed(inout self, data: List[u8], inout out: List[u8]) -> Result[(), compression.Error] {
        self.fed += data.len() as u64
        if !started(self.d) {
            // Deflate and Auto: decide on the first four bytes
            self.head.extend(data)
            if self.head.len() < 4 { return Ok(()) }
            let all = self.head.copy()
            self.head.clear()
            self.choose(all)
            return self.step(all, inout out)
        }
        self.step(data, inout out)
    }

    // Picks the format of a stream from its first bytes.
    fn choose(inout self, head: List[u8]) {
        let chosen = detect(head).unwrap()
        let mut f = chosen.copy()
        if self.fmt == Deflate && chosen != Zlib { f = Raw }
        self.start(f)
    }

    fn start(inout self, f: Format) {
        match f {
            Gzip => { self.d = G(gzip.decoder(self.lim)) }
            Zlib => { self.d = Z(zlib.decoder(self.lim)) }
            Raw => { self.d = R(deflate.inflater(self.lim)) }
            Zstd => { self.d = S(zstd.decoder(self.lim)) }
            _ => { self.d = Copy }
        }
    }

    fn step(inout self, data: List[u8], inout out: List[u8]) -> Result[(), compression.Error] {
        let mut cur = self.d.copy()
        self.d = None_
        match cur {
            G(mut x) => {
                let r = x.feed(data, inout out)
                self.d = G(x)
                r
            }
            Z(mut x) => {
                let r = x.feed(data, inout out)
                self.d = Z(x)
                r
            }
            R(mut x) => {
                let r = x.feed(data, inout out)
                self.d = R(x)
                if r.is_ok() && x.done() && x.rest().len() > 0 {
                    return Err(compression.error(compression.Trailing, "deflate: data after the final block", self.fed))
                }
                r
            }
            S(mut x) => {
                let r = x.feed(data, inout out)
                self.d = S(x)
                r
            }
            Copy => {
                let room = compression.output_cap(self.lim, self.fed)
                if (out.len() as u64) + (data.len() as u64) > room && self.lim.max_output != 0 {
                    self.d = Copy
                    return Err(compression.error(compression.TooLarge, "identity: output over the limit", self.fed))
                }
                out.extend(data)
                self.d = Copy
                Ok(())
            }
            None_ => Ok(())
        }
    }

    /// No more input: Ok if the stream was complete, else `Truncated`.
    fn finish(inout self) -> Result[(), compression.Error] {
        if !started(self.d) {
            // nothing, or fewer than four bytes
            if self.head.len() == 0 { return Err(compression.error(compression.Truncated, "empty input", 0)) }
            let all = self.head.copy()
            self.choose(all)
            self.head.clear()
            let mut sink: List[u8] = List.new()
            self.step(all, inout sink)?
        }
        let mut cur = self.d.copy()
        self.d = None_
        match cur {
            G(mut x) => {
                let r = x.finish()
                self.d = G(x)
                r
            }
            Z(mut x) => {
                let r = x.finish()
                self.d = Z(x)
                r
            }
            R(mut x) => {
                let r = x.finish()
                self.d = R(x)
                r
            }
            S(mut x) => {
                let r = x.finish()
                self.d = S(x)
                r
            }
            _ => Ok(())
        }
    }
}

/// Decodes a whole buffer.
pub fn decode(fmt: Format, data: List[u8], lim: compression.Limits) -> Result[List[u8], compression.Error] {
    let mut d = decoder(fmt, lim)
    let mut out: List[u8] = List.new()
    d.feed(data, inout out)?
    d.finish()?
    Ok(out)
}

type Enc =
    | EG(gzip.Encoder)
    | EZ(zlib.Encoder)
    | ER(deflate.Deflater)
    | ES(zstd.Encoder)
    | EC
    | EN

/// An encoder for any format that can be written: gzip, zlib (and `Deflate`), raw deflate,
/// zstd, identity. Make one with `encoder(format, level)`.
pub type Encoder = { e: Enc, copied: u64 }

/// `level` means the format's own scale: 0 to 9 for gzip, zlib and deflate; 0 to 3 for zstd
/// (see `zstd.encoder`). A negative level is the format's default.
pub fn encoder(fmt: Format, level: i32) -> Encoder {
    match fmt {
        Gzip => Encoder(EG(gzip.encoder(level)), 0)
        Zlib => Encoder(EZ(zlib.encoder(level)), 0)
        Deflate => Encoder(EZ(zlib.encoder(level)), 0)
        Raw => Encoder(ER(deflate.deflater(level)), 0)
        Zstd => Encoder(ES(zstd.encoder(level)), 0)
        Identity => Encoder(EC, 0)
        Auto => Encoder(EC, 0)
    }
}

impl Encoder {
    /// Compresses `data`; appends what is ready to `out`.
    fn write(inout self, data: List[u8], inout out: List[u8]) -> Result[(), compression.Error] {
        let mut cur = self.e.copy()
        self.e = EN
        match cur {
            EG(mut x) => {
                let r = x.write(data, inout out)
                self.e = EG(x)
                r
            }
            EZ(mut x) => {
                let r = x.write(data, inout out)
                self.e = EZ(x)
                r
            }
            ER(mut x) => {
                let r = x.write(data, inout out)
                self.e = ER(x)
                r
            }
            ES(mut x) => {
                let r = x.write(data, inout out)
                self.e = ES(x)
                r
            }
            EC => {
                out.extend(data)
                self.e = EC
                Ok(())
            }
            EN => Ok(())
        }
    }

    /// Makes everything written so far decodable from the output so far (a sync flush).
    fn flush(inout self, inout out: List[u8]) -> Result[(), compression.Error] {
        let mut cur = self.e.copy()
        self.e = EN
        match cur {
            EG(mut x) => {
                let r = x.flush(inout out)
                self.e = EG(x)
                r
            }
            EZ(mut x) => {
                let r = x.flush(inout out)
                self.e = EZ(x)
                r
            }
            ER(mut x) => {
                let r = x.flush(inout out)
                self.e = ER(x)
                r
            }
            ES(mut x) => {
                let r = x.flush(inout out)
                self.e = ES(x)
                r
            }
            EC => {
                self.e = EC
                Ok(())
            }
            EN => Ok(())
        }
    }

    /// Ends the stream.
    fn finish(inout self, inout out: List[u8]) -> Result[(), compression.Error] {
        let mut cur = self.e.copy()
        self.e = EN
        match cur {
            EG(mut x) => {
                let r = x.finish(inout out)
                self.e = EG(x)
                r
            }
            EZ(mut x) => {
                let r = x.finish(inout out)
                self.e = EZ(x)
                r
            }
            ER(mut x) => {
                let r = x.finish(inout out)
                self.e = ER(x)
                r
            }
            ES(mut x) => {
                let r = x.finish(inout out)
                self.e = ES(x)
                r
            }
            EC => {
                self.e = EC
                Ok(())
            }
            EN => Ok(())
        }
    }
}

/// Encodes a whole buffer.
pub fn encode(fmt: Format, data: List[u8], level: i32) -> List[u8] {
    let mut e = encoder(fmt, level)
    let mut out: List[u8] = List.new()
    match e.write(data, inout out) {
        Ok(_) => {}
        Err(_) => {}
    }
    match e.finish(inout out) {
        Ok(_) => {}
        Err(_) => {}
    }
    out
}

// ---- Accept-Encoding

fn lower(b: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    for c in b { out.push(if c >= 65 && c <= 90 { c + 32 } else { c }) }
    out
}

fn trim(b: List[u8]) -> List[u8] {
    let mut s: usize = 0
    let mut e = b.len()
    while s < e && (b[s] == 32 || b[s] == 9) { s += 1 }
    while e > s && (b[e - 1] == 32 || b[e - 1] == 9) { e -= 1 }
    b.slice(s, e)
}

// "0", "1", "0.5", "0.123" (up to three decimals) as thousandths; -1 if malformed
fn qvalue(b: List[u8]) -> i32 {
    if b.len() == 0 { return -1 }
    if b[0] != 48 && b[0] != 49 { return -1 }
    let mut v: i32 = ((b[0] - 48) as i32) * 1000
    if b.len() == 1 { return v }
    if b[1] != 46 || b.len() > 5 { return -1 }
    let mut scale: i32 = 100
    let mut i: usize = 2
    while i < b.len() {
        if b[i] < 48 || b[i] > 57 { return -1 }
        v += ((b[i] - 48) as i32) * scale
        scale = scale / 10
        i += 1
    }
    if v > 1000 { return -1 }
    v
}

fn coding_names(f: Format) -> List[str] {
    match f {
        Gzip => List["gzip", "x-gzip"]
        Zlib => List["deflate"]
        Raw => List["deflate"]
        Deflate => List["deflate"]
        Zstd => List["zstd"]
        Identity => List["identity"]
        Auto => List["identity"]
    }
}

/// The coding to answer with: the best of `offered` (the server's order of preference, first
/// wins a tie) that the Accept-Encoding header value `accept` allows, by the q-values (`q=0`
/// forbids, `*` stands for the codings not named, a missing q is 1, malformed items are
/// ignored). None when nothing offered is allowed or the header is empty: send the body as it
/// is (identity), without a Content-Encoding.
pub fn negotiate(accept: List[u8], offered: List[Format]) -> Option[Format] {
    let mut names: List[List[u8]] = List.new()
    let mut qs: List[i32] = List.new()
    let mut star: i32 = -1
    let mut start: usize = 0
    let n = accept.len()
    let mut i: usize = 0
    while i <= n {
        if i == n || accept[i] == 44 {
            let item = trim(accept.slice(start, i))
            start = i + 1
            if item.len() > 0 {
                // coding[;q=value]
                let mut semi: usize = item.len()
                let mut k: usize = 0
                while k < item.len() {
                    if item[k] == 59 {
                        semi = k.copy()
                        break
                    }
                    k += 1
                }
                let name = lower(trim(item.slice(0, semi)))
                let mut q: i32 = 1000
                if semi < item.len() {
                    let param = lower(trim(item.slice(semi + 1, item.len())))
                    if param.len() >= 2 && param[0] == 113 && param[1] == 61 {
                        q = qvalue(trim(param.slice(2, param.len())))
                    }
                }
                if q >= 0 && name.len() > 0 {
                    if name.len() == 1 && name[0] == 42 {
                        star = q
                    } else {
                        names.push(name)
                        qs.push(q)
                    }
                }
            }
        }
        i += 1
    }
    let mut best: Option[Format] = None
    let mut best_q: i32 = 0
    for f in offered {
        let mut q: i32 = -1
        for alias in coding_names(f) {
            for j in 0..names.len() {
                if eq(names[j], alias) && qs[j] > q { q = qs[j] }
            }
        }
        if q < 0 { q = star }
        if q > best_q {
            best_q = q
            best = Some(f.copy())
        }
    }
    best
}
